{
  "manifest_version": 3,
  "name": "MINDLOCK",
  "version": "1.0.0",
  "description": "Digital distraction management for company-managed devices.",
  "permissions": ["storage", "tabs", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "MINDLOCK",
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
