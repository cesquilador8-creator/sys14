{
  "manifest_version": 3,
  "name": "Sys14 Distraction Manager",
  "version": "1.0.0",
  "description": "Employee productivity and website blocking management for company-managed laptops.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Sys14 Distraction Manager",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
